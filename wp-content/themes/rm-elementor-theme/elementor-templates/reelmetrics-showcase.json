            {
              "id": "instructions-text",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<h3 style='color: #5E55FC; margin-top: 40px;'>For Typography:</h3><ol style='color: #FFFFFF; font-size: 18px; line-height: 150%;'><li>Add a Heading widget</li><li>Look for 'ReelMetrics Typography' dropdown in Content tab</li><li>Select your desired style (Hero Large, Intro Large, etc.)</li></ol><h3 style='color: #5E55FC; margin-top: 40px;'>For Buttons:</h3><ol style='color: #FFFFFF; font-size: 18px; line-height: 150%;'><li>Add a Button widget</li><li>Look for 'ReelMetrics Button Style' dropdown</li><li>Choose Primary (Blurple), Secondary (Black), or CTA styles</li></ol><h3 style='color: #5E55FC; margin-top: 40px;'>For Colors:</h3><ol style='color: #FFFFFF; font-size: 18px; line-height: 150%;'><li>Click any color picker in Elementor</li><li>Click the globe icon for Global Colors</li><li>Select from ReelMetrics palette</li></ol><h3 style='color: #5E55FC; margin-top: 40px;'>Custom Widgets:</h3><p style='color: #FFFFFF; font-size: 18px; line-height: 150%;'>Look for the 'ReelMetrics' category in the widget panel for RM Typography, RM Button, and RM Navigation widgets.</p>"
              }
            }
          ]
